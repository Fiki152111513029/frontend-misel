# Base URL of the NestJS backend API (no trailing slash, no /api prefix —
# routes are e.g. /box-types, /auth/login).
#
# NOTE: the Nuxt dev server's own port (3000) collides with the backend's
# default port (also 3000) — run the backend on a different port
# (e.g. PORT=3001 in backend/.env) and match it here.
NUXT_PUBLIC_API_BASE=http://localhost:3001
